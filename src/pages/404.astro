---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="페이지를 찾을 수 없어요 | 퍼필" description="요청한 페이지를 찾을 수 없어요. 퍼필 독서 기록 앱 홈으로 이동해 주세요.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="not-found">
    <img src={`${base}/characters/ghost.webp`} alt="" width="120" height="120" aria-hidden="true" />
    <h1>페이지를 찾을 수 없어요</h1>
    <p>주소가 바뀌었거나 없는 페이지예요.</p>
    <a href={`${base}/`} class="home-link">퍼필 홈으로</a>
  </section>
</Layout>

<style>
  .not-found {
    text-align: center;
    padding: 60px 0;
  }
  .not-found img {
    margin: 0 auto 20px;
    display: block;
  }
  .not-found p {
    color: var(--gray-600);
  }
  .home-link {
    display: inline-block;
    margin-top: 16px;
    padding: 12px 24px;
    border-radius: 999px;
    background: var(--brand-500);
    color: #fff;
    font-weight: 700;
  }
  .home-link:hover {
    color: #fff;
    background: var(--brand-600);
  }
</style>
